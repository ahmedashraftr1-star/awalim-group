# generated by build.mjs — do not edit by hand. Source: SECURITY_HEADERS,
# CACHE_RULES and REDIRECTS in build.mjs (the same list _headers, _redirects
# and vercel.json are written from). The CSP carries per-build script hashes.

Options -Indexes -MultiViews
DirectoryIndex index.html
# /work must not 301 to /work/ (the canonical URL has no trailing slash): the
# rewrite below maps a directory to its index.html instead. Measured on Apache
# 2.4 — without this, mod_dir redirects before the rewrite runs.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
AddDefaultCharset utf-8
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
  ErrorDocument 404 /en/404/index.html
</If>

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/rss+xml .rss
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType image/x-icon .ico
  AddCharset utf-8 .html .css .js .json .xml .txt .webmanifest
</IfModule>

# ---- private: never served, even if uploaded by mistake ----
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(\.(?!well-known)[^/]+|src|scripts|shots|node_modules|dashboard|en/dashboard|serenity-spa[^/]*)(/|$)
</IfModule>
<FilesMatch "\.(zip|gz|md|mjs|pem|py|sh|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(_headers|_redirects|vercel\.json|package(-lock)?\.json|\.htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- one origin: https://awalimgroup.com (www and http redirect here) ----
  RewriteCond %{HTTP_HOST} ^www\.awalimgroup\.com$ [NC]
  RewriteRule ^ https://awalimgroup.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^awalimgroup\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://awalimgroup.com%{REQUEST_URI} [R=301,L]

  # ---- legacy routes ----
  RewriteRule ^about/?$ /group [R=301,L]
  RewriteRule ^about\.html$ /group [R=301,L]
  RewriteRule ^insights/?$ /journal [R=301,L]
  RewriteRule ^insights\.html$ /journal [R=301,L]
  RewriteRule ^work\.html$ /work [R=301,L]
  RewriteRule ^products\.html$ /products [R=301,L]
  RewriteRule ^services\.html$ /services [R=301,L]
  RewriteRule ^academy\.html$ /academy [R=301,L]
  RewriteRule ^contact\.html$ /contact [R=301,L]
  RewriteRule ^start/?$ /contact [R=302,L]
  RewriteRule ^en/about/?$ /en/group [R=301,L]
  RewriteRule ^en/insights/?$ /en/journal [R=301,L]
  RewriteRule ^en/start/?$ /en/contact [R=302,L]

  # /en is the one directory whose canonical URL ends in a slash
  RewriteRule ^en$ /en/ [R=301,L]

  # ---- clean URLs: /work → /work/index.html, served without a trailing-slash redirect ----
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-WdDJbdhgd2aGIBSxWgROYpfUiSkQnu8zmjTf1J991Hg=' 'sha256-ZriVhTnq4wXlPojnCD2FutefCZLnRiHrDymHXGI2euA=' 'sha256-ut8FCfD/iBAMUY8iebvxN0PzWbOrNiN2o3NDD53XFQY='; style-src 'self' 'sha256-KR4gUwZTOejHuo8xbgVympE27JrzLkGZLeE45cOmXJE=' 'sha256-iTap4MWX32x/Bc8tN5Mj1JfwN+iQKq2r4iMznaIQRdA='; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://wa.me; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types awalim-sw awalim-ledger; upgrade-insecure-requests"

  # ---- caching ----
  <FilesMatch "\.(html|json|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.ico$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json image/x-icon
</IfModule>
