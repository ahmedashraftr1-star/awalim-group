{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/group", "permanent": true },
    { "source": "/about.html", "destination": "/group", "permanent": true },
    { "source": "/insights", "destination": "/journal", "permanent": true },
    { "source": "/insights.html", "destination": "/journal", "permanent": true },
    { "source": "/work.html", "destination": "/work", "permanent": true },
    { "source": "/products.html", "destination": "/products", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/academy.html", "destination": "/academy", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/start", "destination": "/contact", "permanent": false },
    { "source": "/en/about", "destination": "/en/group", "permanent": true },
    { "source": "/en/insights", "destination": "/en/journal", "permanent": true },
    { "source": "/en/start", "destination": "/en/contact", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://wa.me; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }] }
  ]
}
