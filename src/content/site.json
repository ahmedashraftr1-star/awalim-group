    {
      "n": "03",
      "t": "التنفيذ",
      "d": "دفعات أسبوعية على بيئة حيّة تراها بنفسك — لا عروض تقديمية. اختبارات آلية تمنع كسر ما كان يعمل، وكل إصدار يمرّ على ميزانية أداء ووصولية.",
      "dur": "دفعة كل أسبوع",
      "out": [
        "بيئة حيّة تُحدَّث أسبوعياً",
        "اختبارات آلية تمنع الانحدار",
        "تقرير أداء ووصولية لكل إصدار"
      ],
      "keep": "الكود في مستودعك من أول يوم — لا من يوم التسليم."
    },
